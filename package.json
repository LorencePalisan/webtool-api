{
  "name": "nexus-portal-backend",
  "version": "1.0.0",
  "description": "Backend API for Nexus Portal with MySQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "mock": "node mock-server.js",
    "dev": "nodemon server.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:schema": "wrangler d1 execute nexus-portal-db --file=src/schema.sql",
    "cf:schema:local": "wrangler d1 execute nexus-portal-db --local --file=src/schema.sql"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "hono": "^4.0.0",
    "jose": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.6.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "nodemon": "^3.0.2",
    "wrangler": "^3.0.0"
  }
}
